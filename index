<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirecting...</title>
    <script>
        (function() {
            var params = new URLSearchParams(window.location.search);
            var token = params.get('t');
            if (!token && window.location.hash) {
                token = window.location.hash.substring(1);
            }
            if (token) {
                token = token.replace(/^\/+|\/+$/g, '');
                // Redirects instantly with no delay screen:
                window.location.replace("https://eximtag.in/?rqr_token=" + encodeURIComponent(token));
            } else {
                window.location.replace("https://eximtag.in/");
            }
        })();
    </script>
</head>
<body style="background:#0f172a; color:#fff; display:flex; justify-content:center; align-items:center; height:100vh; font-family:sans-serif; margin:0;">
    <p>Opening card destination...</p>
</body>
</html>
